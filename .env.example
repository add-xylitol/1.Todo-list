# Server configuration
PORT=8000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*

# Database configuration
# Set DB_DIALECT to "mysql" when using a managed MySQL instance.
DB_DIALECT=sqlite
DB_STORAGE=server/data/todolist.sqlite
# DB_HOST=your.mysql.host
# DB_PORT=3306
# DB_NAME=todolist
# DB_USER=username
# DB_PASS=password

# Demo account seeding (optional)
# SEED_USER1_NAME=PartnerOne
# SEED_USER1_EMAIL=partner.one@example.com
# SEED_USER1_PASSWORD=TodoList#1
# SEED_USER2_NAME=PartnerTwo
# SEED_USER2_EMAIL=partner.two@example.com
# SEED_USER2_PASSWORD=TodoList#2
